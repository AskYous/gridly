Screen {
    background: $surface;
}

#grid {
    height: 1fr;
    width: 1fr;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
}

.dialog {
    width: 52;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

.dialog--wide {
    width: 60;
}

/* The form takes over the screen, but the fields stay a readable width. */
.form {
    width: 100%;
    height: 100%;
    align-horizontal: center;
    background: $surface;
}

.form-inner {
    width: 68;
    max-width: 100%;
    height: 100%;
    padding: 1 2;
}

.form-fields {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

.form Label {
    width: 1fr;
    padding-bottom: 1;
}

.form .dialog-title {
    padding-bottom: 1;
    text-style: bold;
}

.form .field-label {
    padding: 1 0 0 0;
    color: $text-muted;
}

.form Input, .form Select, .form TextArea {
    width: 1fr;
}

.form TextArea {
    height: 5;
}

.dialog Label {
    width: 1fr;
    padding-bottom: 1;
}

.dialog .dialog-title {
    padding-bottom: 0;
}

.dialog .field-label {
    padding: 1 0 0 0;
    color: $text-muted;
}

.dialog Input, .dialog Select, .dialog TextArea {
    width: 1fr;
}

.dialog TextArea {
    height: 8;
}

.dialog OptionList {
    height: auto;
    max-height: 12;
    border: none;
    background: $boost;
}

.dialog-help {
    padding-top: 1;
}

.error {
    height: auto;
    color: $error;
}

.buttons {
    height: auto;
    padding-top: 1;
    align-horizontal: right;
}

.buttons Button {
    margin-left: 1;
}

CellEditScreen, PickScreen, ColumnScreen, ConfirmScreen, HelpScreen, RowFormScreen {
    align: center middle;
    background: $background 60%;
}

/* Field boxes.
   Textual's default "tall" border draws its top and bottom rules one cell in
   from the widget's left edge — the corner column holds a vertical block
   instead — so every field reads as indented against the label above it. A
   round border puts a real corner on that column, flush with the label. The
   padding is set here too because Input and Select default to two cells and
   TextArea to one, which left the three kinds of field starting their text at
   three different columns. */
.dialog Input, .dialog TextArea, .dialog SelectCurrent,
.form Input, .form TextArea, .form SelectCurrent {
    border: round $border-blurred;
    padding: 0 1;
}

.dialog Input:focus, .dialog TextArea:focus, .dialog Select:focus SelectCurrent,
.form Input:focus, .form TextArea:focus, .form Select:focus SelectCurrent {
    border: round $border;
}
