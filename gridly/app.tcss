Screen {
    background: $surface;
}

#grid {
    height: 1fr;
    width: 1fr;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
}

.dialog {
    width: 52;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

.dialog--wide {
    width: 60;
}

/* The form takes over the screen, but the fields stay a readable width. */
.form {
    width: 100%;
    height: 100%;
    align-horizontal: center;
    background: $surface;
}

.form-inner {
    width: 68;
    max-width: 100%;
    height: 100%;
    padding: 1 2;
}

.form-fields {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

.form Label {
    width: 1fr;
    padding-bottom: 1;
}

.form .dialog-title {
    padding-bottom: 1;
    text-style: bold;
}

.form .field-label {
    padding: 1 0 0 0;
    color: $text-muted;
}

.form Input, .form Select, .form TextArea {
    width: 1fr;
}

.form TextArea {
    height: 5;
}

.dialog Label {
    width: 1fr;
    padding-bottom: 1;
}

.dialog .dialog-title {
    padding-bottom: 0;
}

.dialog .field-label {
    padding: 1 0 0 0;
    color: $text-muted;
}

.dialog Input, .dialog Select, .dialog TextArea {
    width: 1fr;
}

.dialog TextArea {
    height: 8;
}

.dialog OptionList {
    height: auto;
    max-height: 12;
    border: none;
    background: $boost;
}

.dialog-help {
    padding-top: 1;
}

.error {
    height: auto;
    color: $error;
}

.buttons {
    height: auto;
    padding-top: 1;
    align-horizontal: right;
}

.buttons Button {
    margin-left: 1;
}

CellEditScreen, PickScreen, ColumnScreen, ConfirmScreen, HelpScreen, RowFormScreen {
    align: center middle;
    background: $background 60%;
}

/* Field boxes.
   Textual's default "tall" border draws its top and bottom rules one cell in
   from the widget's left edge — the corner column holds a vertical block
   instead — so every field reads as indented against the label above it. A
   round border puts a real corner on that column, flush with the label. The
   padding is set here too because Input and Select default to two cells and
   TextArea to one, which left the three kinds of field starting their text at
   three different columns. */
.dialog Input, .dialog TextArea, .dialog SelectCurrent,
.form Input, .form TextArea, .form SelectCurrent {
    border: round $border-blurred;
    padding: 0 1;
}

.dialog Input:focus, .dialog TextArea:focus, .dialog Select:focus SelectCurrent,
.form Input:focus, .form TextArea:focus, .form Select:focus SelectCurrent {
    border: round $border;
}

/* The dropdown's options are a list, so they get a line each rather than one
   long comma-separated field. The dialog takes the height it needs up to the
   screen, and the fields scroll inside it so Save is always reachable. */
HelpScreen .dialog {
    height: 100%;
    max-height: 24;
}

HelpScreen .dialog {
    width: 66;
    max-height: 32;
}

.help-heading {
    padding-top: 1;
    color: $text-accent;
}

HelpScreen .dialog-fields {
    height: 1fr;
    scrollbar-size-vertical: 1;
}



/* The sheet picker, shown when the command line named no file. */
.picker {
    width: 72;
    max-width: 100%;
    height: 100%;
    padding: 1 2;
}

PickerApp {
    align-horizontal: center;
}

.picker Label {
    width: 1fr;
    padding-bottom: 1;
}

.picker OptionList {
    height: 1fr;
    border: round $border-blurred;
    background: $surface;
}

.picker OptionList:focus {
    border: round $border;
}

.picker Input {
    width: 1fr;
    border: round $border-blurred;
    padding: 0 1;
}

.picker Input:focus {
    border: round $border;
}

/* One row per dropdown option: its name, its colour, and a way to drop it. */
/* No scroll of its own: the form's own body is what scrolls. */
#options {
    height: auto;
}

.option-row {
    height: 1;
    width: 1fr;
    margin-bottom: 1;
}

/* These beat the bordered look the dialog gives its fields, focused or not:
   an option row is one line, and a border on a one-line widget leaves nothing
   but its edge showing. Focus is a lit background instead. */
.option-row .option-name, .option-row .option-color SelectCurrent,
.option-row .option-name:focus, .option-row .option-color:focus SelectCurrent {
    border: none;
    height: 1;
    padding: 0 1;
    background: $boost;
}

.option-row .option-name:focus, .option-row .option-color:focus SelectCurrent {
    background: $primary 40%;
    color: $text;
}

.option-row .option-name {
    width: 1fr;
}

.option-row .option-color {
    width: 18;
    height: 1;
    margin-left: 1;
}

.option-row .option-remove {
    margin-left: 1;
    min-width: 3;
}

#add-option {
    margin-top: 1;
}
